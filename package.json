{
  "name": "specular-ui",
  "version": "0.1.0",
  "description": "Lighting-first material UI components for the web. Liquid glass, brushed metal, frost and holographic surfaces driven by a single shared light source.",
  "type": "module",
  "main": "dist/specular-ui.cjs",
  "module": "dist/specular-ui.js",
  "style": "dist/specular-ui.css",
  "exports": {
    ".": {
      "import": "./dist/specular-ui.js",
      "require": "./dist/specular-ui.cjs"
    },
    "./css": "./dist/specular-ui.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 test/unit.test.mjs test/contrast.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/browser.test.mjs test/optical.test.mjs test/controls.test.mjs",
    "audit:contrast": "node scripts/contrast.mjs"
  },
  "keywords": [
    "ui",
    "components",
    "material",
    "glassmorphism",
    "liquid-glass",
    "web-components",
    "design-system",
    "refraction"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/llinok111/specular-ui"
  },
  "devDependencies": {
    "esbuild": "^0.19.0"
  }
}
